DATABASE_URL="postgresql://futsal_admin:YOUR_PASSWORD@localhost:5432/futsal_team?schema=public"
# Required. Never reuse this placeholder: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-random-64-hex"
WEATHER_API_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Generate a persistent secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOM_VOTE_SECRET=""
# Empty for direct access / router port forwarding. See README before enabling proxies.
MOM_VOTE_TRUSTED_PROXY_IPS=""
# Days to keep admin access logs (raw IPs) before automatic deletion.
ACCESS_LOG_RETENTION_DAYS="90"

# platform: multi-team service (default), legacy: original ARENA FC only.
APP_MODE="platform"
