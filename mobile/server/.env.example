# 동호회·풋살장 예약 앱 서버 (mobile/server) 환경 설정 예시
# ARENA 웹사이트의 .env / DATABASE_URL 과 무관합니다. 이 서버는 별도 SQLite 파일을 사용합니다.

# development | test | production
APP_ENV=development
HOST=127.0.0.1          # 실기기 테스트 시 0.0.0.0 (방화벽 확인)
PORT=8791
DB_PATH=data/club.sqlite
STORAGE_DIR=data/files

# 운영 필수: 32자 이상 임의 값 (세션·인증번호·전화번호 HMAC에 사용)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# 카카오 로그인 (서버가 액세스 토큰의 app_id를 검증). 비우면 카카오 로그인 비활성.
KAKAO_APP_ID=

# demo: 문자 발송 없이 인증번호를 응답에 포함 (production에서는 금지)
# disabled: 인증 요청 시 503 (실제 문자 연동 전 운영 상태)
SMS_MODE=demo

# ARENA 가져오기 원본 (읽기 전용 GET만 사용)
ARENA_SOURCE_URL=http://49.143.102.211:3932

# Flutter 웹 빌드 폴더 (예: ../build/web). 비우면 API만 제공.
WEB_ROOT=
