{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev-platform/types/**/*.ts",
    ".next-mobile-roles-check/types/**/*.ts",
    ".next-mobile-polls-check/types/**/*.ts",
    ".next-mobile-legacy-polls-check/types/**/*.ts",
    ".next-mobile-legacy-polls-admin-only/types/**/*.ts",
    ".next-mobile-legacy-polls-private-results/types/**/*.ts",
    ".next-mobile-legacy-polls-turnout/types/**/*.ts",
    ".next-mobile-legacy-polls-turnout-clean/types/**/*.ts",
    ".next-mobile-legacy-polls-invalidate/types/**/*.ts",
    ".next-mobile-legacy-polls-candidates/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
