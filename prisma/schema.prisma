generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  createdPolls ClubPoll[]
  clubBallots ClubPollBallot[]
  teams        TeamAdmin[]
  mobileSessions MobileSession[]
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Player {
  teamId              Int           @default(1)
  team                Team          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  id                  Int           @id @default(autoincrement())
  name                String
  nickname            String?
  profileImageUrl     String?
  position            String
  number              Int?
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  matchPlayers        MatchPlayer[]
  scoredGoals         MatchGoal[]   @relation("GoalScorer")
  assistedGoals       MatchGoal[]   @relation("GoalAssister")
  chairmanMvpMatches  Match[]       @relation("ChairmanTeamMvp")
  managerMvpMatches   Match[]       @relation("ManagerTeamMvp")
  momTeamABallots      MomBallot[]   @relation("MomTeamAVote")
  momTeamBBallots      MomBallot[]   @relation("MomTeamBVote")
  pollOptions          ClubPollOption[]

  @@index([teamId])
}

model Match {
  teamId             Int           @default(1)
  team               Team          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  id                 Int           @id @default(autoincrement())
  status             String        @default("COMPLETED")
  matchDate          DateTime
  location           String
  teamAName          String
  teamBName          String
  teamAScore         Int
  teamBScore         Int
  winnerTeam         String?
  chairmanTeamMvpId  Int?
  managerTeamMvpId   Int?
  memo               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  chairmanTeamMvp    Player?       @relation("ChairmanTeamMvp", fields: [chairmanTeamMvpId], references: [id])
  managerTeamMvp     Player?       @relation("ManagerTeamMvp", fields: [managerTeamMvpId], references: [id])
  matchPlayers       MatchPlayer[]
  goals              MatchGoal[]
  posters            MatchPoster[]
  momBallots         MomBallot[]

  @@index([teamId, matchDate])
}

model MomBallot {
  id            Int      @id @default(autoincrement())
  matchId       Int
  voterHash     String   @db.VarChar(64)
  teamAPlayerId Int?
  teamBPlayerId Int?
  createdAt     DateTime @default(now())
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamAPlayer   Player?  @relation("MomTeamAVote", fields: [teamAPlayerId], references: [id], onDelete: SetNull)
  teamBPlayer   Player?  @relation("MomTeamBVote", fields: [teamBPlayerId], references: [id], onDelete: SetNull)

  @@unique([matchId, voterHash])
}

model MatchPlayer {
  id        Int      @id @default(autoincrement())
  matchId   Int
  playerId  Int
  teamName  String
  /// SQLite connector stores MatchResult values as text: WIN, LOSS, DRAW.
  result    String
  goals     Int      @default(0)
  assists   Int      @default(0)
  isMvp     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model MatchPoster {
  id        Int      @id @default(autoincrement())
  matchId   Int
  imageUrl  String
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MatchGoal {
  id          Int      @id @default(autoincrement())
  matchId     Int
  scorerId    Int
  assisterId  Int?
  sequence    Int
  assistKnown Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  scorer      Player   @relation("GoalScorer", fields: [scorerId], references: [id], onDelete: Restrict)
  assister    Player?  @relation("GoalAssister", fields: [assisterId], references: [id], onDelete: Restrict)

  @@unique([matchId, scorerId, sequence])
  @@index([assisterId])
}

model MobileSession {
  tokenHash       String   @id
  adminId         Int
  passwordVersion String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  admin           Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([adminId])
}

model AccessLog {
  teamId    Int      @default(1)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  id        Int      @id @default(autoincrement())
  ip        String   @db.VarChar(45)
  path      String   @db.VarChar(512)
  referrer  String?  @db.VarChar(512)
  userAgent String?  @db.VarChar(512)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
  @@index([teamId, createdAt])
}

model Team {
  polls       ClubPoll[]
  id          Int         @id @default(autoincrement())
  slug        String      @unique @db.VarChar(48)
  name        String      @db.VarChar(60)
  description String      @default("") @db.VarChar(300)
  region      String      @default("") @db.VarChar(60)
  sport       String      @default("FUTSAL") @db.VarChar(12)
  recruiting  Boolean     @default(false)
  schedule    String      @default("") @db.VarChar(100)
  joinUrl     String      @default("") @db.VarChar(300)
  color       String      @default("#e53935") @db.VarChar(7)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  admins      TeamAdmin[]
  players     Player[]
  matches     Match[]
  accessLogs  AccessLog[]
}

model TeamAdmin {
  teamId    Int
  adminId   Int
  /// Membership role; the historical model/table name is kept for compatibility.
  role      String @default("MEMBER") @db.VarChar(12)
  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  admin     Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([teamId, adminId])
  @@index([adminId])
}

model ClubPoll {
  id          String    @id @default(cuid())
  teamId      Int
  audience    String    @default("MEMBERS") @db.VarChar(12)
  creatorId   Int?
  title       String    @db.VarChar(120)
  description String    @default("") @db.VarChar(2000)
  closesAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator     Admin?    @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  options     ClubPollOption[]
  ballots     ClubPollBallot[]
  guestBallots ClubPollGuestBallot[]
  invalidBallots ClubPollInvalidBallot[]

  @@index([teamId, createdAt])
}

model ClubPollOption {
  id       String @id @default(cuid())
  pollId   String
  label    String @db.VarChar(120)
  position Int
  // A roster candidate: the photo follows the profile, while the season record
  // is captured when the poll is created.
  playerId Int?
  detail   String @default("") @db.VarChar(200)
  poll     ClubPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  ballots  ClubPollBallot[]
  guestBallots ClubPollGuestBallot[]
  invalidBallots ClubPollInvalidBallot[]

  @@unique([pollId, id])
  @@unique([pollId, position])
  @@index([playerId])
}

model ClubPollBallot {
  pollId    String
  voterId   Int
  optionId  String
  createdAt DateTime @default(now())
  poll      ClubPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voter     Admin @relation(fields: [voterId], references: [id], onDelete: Cascade)
  option    ClubPollOption @relation(fields: [pollId, optionId], references: [pollId, id], onDelete: Cascade)

  @@id([pollId, voterId])
  @@index([pollId, optionId])
  @@index([voterId])
}

model ClubPollGuestBallot {
  // Generated by the database so builds older than this column keep voting.
  id         String @unique @default(dbgenerated("(gen_random_uuid())::text"))
  pollId     String
  nameKey    String @db.VarChar(40)
  name       String @db.VarChar(40)
  receiptHash String @db.VarChar(64)
  optionId   String
  createdAt  DateTime @default(now())
  poll       ClubPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option     ClubPollOption @relation(fields: [pollId, optionId], references: [pollId, id], onDelete: Cascade)

  @@id([pollId, nameKey])
  @@unique([pollId, receiptHash])
  @@index([pollId, optionId])
}

// A guest ballot voided by an administrator. It is kept for the record but no
// longer counts or reserves the voter's name and browser receipt.
model ClubPollInvalidBallot {
  id            String   @id
  pollId        String
  name          String   @db.VarChar(40)
  optionId      String
  createdAt     DateTime
  invalidatedAt DateTime @default(now())
  poll          ClubPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option        ClubPollOption @relation(fields: [pollId, optionId], references: [pollId, id], onDelete: Cascade)

  @@index([pollId, invalidatedAt])
}
